  "formulas": {
    "perTypeAcceptance": "a_i=0 when disabled/minimumDropLevel>ilvl; otherwise 1-(affinityRerollChance if classAffinity & (1<<classID) else rerollChance); Idol a_i additionally zero if excluded, otherwise multiplied by 1-globalIdolRerollChance.",
    "A": "sum_i a_i over all42 candidates; do not shrink the candidate list to23 or remove non-affinal types.",
    "q": "1-A/42",
    "finiteCapReturnedTypeProbability": "P_i=(a_i/A)*(1-q^1000)+q^1000/42; initial candidate is tested, each rejection redraws, after rejection1000 returns the new untested candidate.",
    "raw2CoefficientIgnoringCapTail": "A_gear/(A_gear+A_idols); each ordinary type has the same acceptance weight across raw0..4, so this raw2 factor is common after conditioning on that type.",
    "exactFiniteCapRaw2Coefficient": "[(a_i/A_withIdols)*(1-q_withIdols^1000)+q_withIdols^1000/42]/[(a_i/A_gear)*(1-q_gear^1000)+q_gear^1000/42]; strict finite-cap ratio is type-dependent by a term smaller than~1e-267.",
    "conditionalRawWeights": "P(raw=n | returned type=i, ordinary)=rawWeight[n]*P(type=i|raw=n) / sum_m rawWeight[m]*P(type=i|raw=m); rawWeight must first come from the selected natural-drop context.",
    "commonRawWeightShortcut": "Ignoring the reported finite-cap tail, multiply only rawWeight[2] by the selected PLAYER class k, then renormalize raw0..4. This does not yet handle unique/set fallback or selected subtype-class completion."
  },
